# The Research Compute Gateway. architecture.md 3.4.
#
# Runs on the sandbox network so laboratories can reach it, and on the host network so it can reach
# OpenRouter. That dual attachment is why the gateway and not the laboratory holds the credential:
# the sandbox side has no route out except through this process.
FROM python:3.12-slim

RUN useradd --uid 1000 --create-home rcg
WORKDIR /app

COPY pyproject.toml /app/
COPY protocol/ /app/protocol/
COPY gateway/ /app/gateway/

RUN pip install --no-cache-dir \
      "fastapi==0.115.5" "uvicorn==0.32.1" "openai==1.109.1" \
      "pydantic==2.9.2" "cbor2==5.6.5"

# Non-root, and no writable application directory. The gateway holds credentials in memory and has
# nothing to write; a writable /app would only be somewhere to drop one.
USER 1000:1000

EXPOSE 8081
ENTRYPOINT ["python", "-m", "gateway"]
CMD ["--host", "0.0.0.0", "--port", "8081"]
